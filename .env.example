# Environment variables (examples)

# OAuth / Uploaders (fill when you register apps)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional API keys for paid/3rd-party services
ELEVENLABS_API_KEY=
RUNWAY_API_KEY=

# Local storage / S3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Misc
DEFAULT_OUTPUT_DIR=outputs
