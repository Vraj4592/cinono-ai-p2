# Systemd unit: Cinono API

[Unit]
Description=Cinono AI API
After=network.target

[Service]
Type=simple
User=youruser
WorkingDirectory=/path/to/cinono-ai-p2
ExecStart=/path/to/cinono-ai-p2/venv/bin/uvicorn api.app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
